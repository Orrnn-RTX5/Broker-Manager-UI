# Copy to .env.terminal for local development. CI writes .env from its secret;
# local mode files are ignored by Git and excluded from Docker builds.
# Set false on backends without /reports/v1/summary to use dashboard fallbacks.
VITE_REPORTS_SUMMARY_ENABLED=true
# Optional: pin the UI to one broker instead of allowing discovery selection.
# VITE_BROKER_ID=example-broker
VITE_BACKEND_TARGET=web
VITE_API_HOST=https://api.example.invalid
VITE_API_HOST_EXT=https://api.example.invalid
VITE_REPORTS_API_HOST=https://api.example.invalid
VITE_WS_HOST=wss://api.example.invalid
VITE_MANAGER_WS_HOST=wss://api.example.invalid
VITE_WS_FEED_PATH=/ws/feed
VITE_FEED_WS_URL=wss://api.example.invalid/ws/feed
VITE_FEED_STATUS_URL=https://api.example.invalid/ws/feed/status
VITE_FEED_BROKER_ID=example_broker
VITE_DEFAULT_MT5_SERVER=198.51.100.10
VITE_DISCOVERY_BASE_URL=https://discovery.example.invalid
VITE_USE_MOCK_DISCOVERY=false
VITE_MANAGER_USE_DEV_PROXY=true
VITE_MANAGER_PROXY_STRIP_MANAGER_PREFIX=false
VITE_FEED_USE_DEV_PROXY=true
VITE_FEED_PROXY_STRIP_ORIGIN=true
VITE_MARKET_DATA_SOURCE=manager

# Enable group migration/deletion for specific broker IDs after the backend
# lifecycle migration is applied. Match MANAGER_GROUP_OPERATIONS_BROKERS there.
# Empty keeps the feature disabled; use comma-separated IDs for rollout.
VITE_GROUP_OPERATIONS_BROKERS=

# Optional market-watch websocket path override (applies when broker metadata doesn't provide one)
# Keep default `/ws/feed` unless your broker metadata requires another path.
# VITE_WS_FEED_PATH=/ws/feed

# The bridge market feed at /ws/feed is open and takes no credentials.
# VITE_FEED_BROKER_ID is only a plain label sent as ?broker_id= for bridge logs.
# VITE_FEED_BROKER_ID=example_broker
