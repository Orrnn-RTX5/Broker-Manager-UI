# Copy to .env for local overrides, or use the mode files:
# - .env.web for normal web builds
# - .env.electron / .env.desktop for Electron desktop builds
VITE_BACKEND_TARGET=web
VITE_API_HOST=https://services.growtradingacademy.com
VITE_API_HOST_EXT=https://services.growtradingacademy.com
VITE_WS_HOST=wss://services.growtradingacademy.com
VITE_DEFAULT_MT5_SERVER=103.91.186.142
VITE_DISCOVERY_BASE_URL=https://superbackend.orrnn.com
VITE_USE_MOCK_DISCOVERY=false

# Optional market-watch websocket path override (applies when broker metadata doesn't provide one)
# Keep default `/ws/feed` unless your broker metadata requires another path.
# VITE_WS_FEED_PATH=/ws/feed
