# Copy to .env for local development and broker profile switching.
# Changing the broker variables in .env connects the Manager UI to that broker.
VITE_BACKEND_TARGET=web
VITE_BROKER_ID=your-broker-id
VITE_FEED_BROKER_ID=your-broker-id
VITE_API_HOST=https://broker.example.com
VITE_API_HOST_EXT=https://broker.example.com
VITE_REPORTS_API_HOST=https://broker.example.com
VITE_WS_HOST=wss://broker.example.com
VITE_MANAGER_WS_HOST=wss://broker.example.com
VITE_WS_FEED_PATH=/ws/feed
VITE_FEED_WS_URL=wss://broker.example.com/ws/feed
VITE_FEED_STATUS_URL=https://broker.example.com/ws/feed/status
VITE_DISCOVERY_BASE_URL=https://superadmin-prod.orrnn.com
VITE_USE_MOCK_DISCOVERY=false
VITE_DEFAULT_MT5_SERVER=broker.example.com
VITE_MANAGER_USE_DEV_PROXY=true
VITE_MANAGER_PROXY_STRIP_MANAGER_PREFIX=false
VITE_FEED_USE_DEV_PROXY=true
VITE_FEED_PROXY_STRIP_ORIGIN=true
VITE_MARKET_DATA_SOURCE=manager
VITE_REPORTS_SUMMARY_ENABLED=false

# Enable group migration/deletion for specific broker IDs after the backend
# lifecycle migration is applied. Match MANAGER_GROUP_OPERATIONS_BROKERS there.
# Empty keeps the feature disabled; use comma-separated IDs for rollout.
VITE_GROUP_OPERATIONS_BROKERS=
