{
  "name": "rtx5-broker-manager-ui",
  "private": true,
  "version": "1.0.2",
  "description": "RTX-5 broker manager web and desktop UI",
  "author": "RTX-5",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --mode web",
    "dev:web": "vite --mode web",
    "dev:normal": "vite --mode web",
    "dev:electron": "npm run electron:dev",
    "dev:electron:renderer": "vite --mode electron",
    "dev:desktop": "vite --mode desktop",
    "electron:dev": "concurrently -k \"vite --mode electron\" \"npm:desktop:main:watch\" \"wait-on http://localhost:5173 dist-electron/main.cjs && electron . --dev-server=http://localhost:5173\"",
    "build": "vite build --mode web",
    "build:web": "vite build --mode web",
    "build:normal": "vite build --mode web",
    "build:electron": "vite build --mode electron",
    "build:desktop": "npm run build:electron && npm run desktop:main",
    "desktop:typecheck": "tsc -p tsconfig.electron.json --noEmit",
    "desktop:main": "npm run desktop:typecheck && tsup --config tsup.electron.config.ts",
    "desktop:main:watch": "tsup --config tsup.electron.config.ts --watch",
    "desktop:run": "npm run build:desktop && electron . --use-dist",
    "dist": "npm run build:desktop && electron-builder --win --x64 --publish never",
    "release": "npm run build:desktop && electron-builder --win --x64 --publish always",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\"",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.rtx5.brokermanager",
    "productName": "RTX-5 Broker Manager",
    "artifactName": "RTX-5-Broker-Manager-Setup-${version}.${ext}",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "rtx5-orrnn",
        "repo": "rtx5-broker-manager-releases",
        "private": false,
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "public/logo V2.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RTX-5 Broker Manager"
    }
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.577.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "wait-on": "^9.0.10"
  }
}
