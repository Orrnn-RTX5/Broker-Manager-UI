# ─────────────────────────────────────────────────────────────────────────────
# RTX5 Manager Terminal — single environment profile (mode: terminal)
# Loaded by: vite --mode terminal (all dev/build scripts use this mode)
# ─────────────────────────────────────────────────────────────────────────────

# Build target: web | desktop (set "desktop" for Electron builds)
VITE_BACKEND_TARGET=web

# Broker backend (API + WebSocket)
VITE_API_HOST=https://service.orrnn.com
VITE_API_HOST_EXT=https://service.orrnn.com
VITE_WS_HOST=wss://service.orrnn.com
VITE_WS_FEED_PATH=/ws/feed

# Broker identity — pins the manager session and authenticates the market feed
VITE_BROKER_ID=orrnn
VITE_FEED_BROKER_ID=orrnn
# Set VITE_FEED_BROKER_TOKEN here only if this broker's feed requires one.
VITE_FEED_AUTH_REQUIRED=false
VITE_FEED_SEND_TOKEN=false

# Trading server defaults + broker discovery
VITE_DEFAULT_MT5_SERVER=51.195.188.172
VITE_DISCOVERY_BASE_URL=https://superadmin-prod.orrnn.com
VITE_USE_MOCK_DISCOVERY=false

# Feature flags
VITE_REPORTS_SUMMARY_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Local development only — same-origin dev proxies + API debug logging.
# These are gated by Vite's dev mode (import.meta.env.DEV) and are completely
# ignored in production builds — keep them enabled for `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────
VITE_MANAGER_USE_DEV_PROXY=true
VITE_MANAGER_PROXY_STRIP_MANAGER_PREFIX=true
VITE_FEED_USE_DEV_PROXY=true
VITE_FEED_PROXY_STRIP_ORIGIN=true
# VITE_DEBUG_API=false
