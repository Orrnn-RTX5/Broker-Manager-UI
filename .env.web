# ---------------------------------------------------------------------------
# RTX5 Broker Manager - Trivanta Markets (mode: web)
# Loaded by `npm run dev` / `npm run build` (both use --mode web).
# Desktop builds use .env.electron / .env.desktop instead.
# ---------------------------------------------------------------------------
VITE_BACKEND_TARGET=web
VITE_BROKER_ID=trivanta-markets
VITE_FEED_BROKER_ID=trivanta-markets

# Broker backend (manager API + /ext-api)
VITE_API_HOST=https://trivanta.orrnn.com
VITE_API_HOST_EXT=https://trivanta.orrnn.com
VITE_REPORTS_API_HOST=https://trivanta.orrnn.com

# Websockets
VITE_WS_HOST=wss://trivanta.orrnn.com
VITE_MANAGER_WS_HOST=wss://trivanta.orrnn.com
VITE_WS_FEED_PATH=/ws/feed
VITE_FEED_WS_URL=wss://trivanta.orrnn.com/ws/feed
VITE_FEED_STATUS_URL=https://trivanta.orrnn.com/ws/feed/status

# Broker fetch / discovery
VITE_DISCOVERY_BASE_URL=https://superadmin-prod.orrnn.com
VITE_USE_MOCK_DISCOVERY=false

VITE_DEFAULT_MT5_SERVER=trivanta.orrnn.com

# Local dev proxy: keeps /manager and /ws/feed same-origin so broker CORS
# does not block login. This backend serves manager routes under /manager,
# so the prefix must NOT be stripped.
VITE_MANAGER_USE_DEV_PROXY=true
VITE_MANAGER_PROXY_STRIP_MANAGER_PREFIX=false
VITE_FEED_USE_DEV_PROXY=true
VITE_FEED_PROXY_STRIP_ORIGIN=true

# Quotes come from the manager stream, not the bridge.
VITE_MARKET_DATA_SOURCE=manager

# This backend does not expose /reports/v1/summary yet; use dashboard fallbacks.
VITE_REPORTS_SUMMARY_ENABLED=false
