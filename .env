# Backend host (HTTP). Used by Vite dev proxy and any absolute API calls.
VITE_API_HOST=http://backend.orrnn.com

# WebSocket host (main feed + account metrics).
VITE_WS_HOST=ws://backend.orrnn.com

# Extended API host (MarketDepth, SessionOverride, SpreadSchedule — was port 8091).
VITE_API_HOST_EXT=http://backend.orrnn.com:8091

# Default MT5 server value shown in the Login form.
VITE_DEFAULT_MT5_SERVER=backend.orrnn.com
